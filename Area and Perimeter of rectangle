#include <stdio.h>

void main()
{
    float a, b, area,peri;

    printf("Enter length of rectangle: ");
    scanf("%f", &a);
    printf("Enter bredth of rectangle: ");
    scanf("%f", &b);
    

    area= a*b;
    peri=2*(a+b);
    
    

    printf("Area of rectangle = %.2f\n", area);
    printf("Perimeter of rectangle = %.2f\n", peri);
}